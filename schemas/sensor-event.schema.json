{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pomona.ag/schemas/sensor-event.schema.json",
  "title": "Pomona Sensor Event",
  "description": "Canonical sensor packet accepted by pomona-core HTTP and MQTT ingestion. A probe that did not report is absent or null; a packet needs at least one non-null reading (anyOf).",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "farm_id", "zone_id", "crop", "growth_stage", "system_type", "timestamp"],
  "anyOf": [
    {"required": ["air_temperature_c"], "properties": {"air_temperature_c": {"type": "number"}}},
    {"required": ["humidity_pct"], "properties": {"humidity_pct": {"type": "number"}}},
    {"required": ["ec_ms_cm"], "properties": {"ec_ms_cm": {"type": "number"}}},
    {"required": ["ph"], "properties": {"ph": {"type": "number"}}},
    {"required": ["soil_moisture_pct"], "properties": {"soil_moisture_pct": {"type": "number"}}},
    {"required": ["substrate_temperature_c"], "properties": {"substrate_temperature_c": {"type": "number"}}},
    {"required": ["substrate_moisture_pct"], "properties": {"substrate_moisture_pct": {"type": "number"}}}
  ],
  "properties": {
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "farm_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "zone_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "crop": {"type": "string", "minLength": 1, "maxLength": 64, "default": "tomato"},
    "growth_stage": {"type": "string", "minLength": 1, "maxLength": 64, "default": "flowering"},
    "system_type": {"type": "string", "minLength": 1, "maxLength": 64, "default": "greenhouse_substrate"},
    "air_temperature_c": {"type": ["number", "null"], "minimum": -40, "maximum": 80},
    "humidity_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "ec_ms_cm": {"type": ["number", "null"], "minimum": 0, "maximum": 20},
    "ph": {"type": ["number", "null"], "minimum": 0, "maximum": 14},
    "soil_moisture_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "substrate_temperature_c": {"type": ["number", "null"], "minimum": -40, "maximum": 80},
    "substrate_moisture_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "timestamp": {"type": "string", "format": "date-time",
      "description": "Sample time, required and timezone-aware; Core rejects times before MIN_SAMPLE_TIME (default 2020-01-01T00:00:00Z)."},
    "source": {"type": ["string", "null"], "maxLength": 64},
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]{1,3}$", "default": "1.0",
      "description": "Payload contract version MAJOR.MINOR; omitted means 1.0. Core rejects other majors."}
  }
}
