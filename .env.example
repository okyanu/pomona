# Pomona local configuration
# Copy to .env — works on macOS, Linux, and Windows (Docker Desktop).
#
#   cp .env.example .env
#
# No OS-specific paths needed. Use Docker for the full stack, or pip for local dev.

COMPOSE_PROJECT_NAME=pomona

# --- Network exposure (Docker) ---
# Which address Docker publishes MQTT (1883), Core (8080) and the dashboard (3000) on. The default,
# 127.0.0.1, is this computer only. Set 0.0.0.0 (or this machine's LAN address) to let real devices on the
# network reach the broker and Core. The dashboard's approve/reject has no login, so only do this on a network
# you trust, and set API_KEY below. The internal services (8081, 8082, 8084, 8085, 11434) stay on 127.0.0.1.
# POMONA_BIND_ADDRESS=127.0.0.1

# --- Core API ---
CORE_HOST=0.0.0.0
CORE_PORT=8080
DB_PATH=data/pomona.db
# Per farm/zone and record type; age cleanup runs on ingest.
MAX_EVENTS=100000
RETENTION_DAYS=7
DEVICE_TIMEOUT_SECONDS=120
# Sample times more than this many seconds ahead of Core's clock are rejected (a logger that writes local time
# but labels it Z lands hours ahead in UTC+ zones). 0 disables the check. The model-router and the automation-engine
# read the same value: a sample time up to this far ahead still counts as current there (0 = the old 60 s limit).
MAX_FUTURE_SAMPLE_S=300
# The farm's IANA time zone (for example Asia/Dubai). Display only: Core stores and compares UTC.
FARM_TIMEZONE=UTC
# Optional: require "Authorization: Bearer <key>" on sensor ingestion.
# Leave empty for local development; set this before exposing core beyond localhost.
API_KEY=
# Sample times before this are rejected (a device clock that was never set stamps 1970 or 2000).
# MIN_SAMPLE_TIME=2020-01-01T00:00:00Z
# Core forwards each new full packet to model-router (rules_only) and automation-engine so alerts
# and approval outcomes move without the dashboard. Docker Compose sets both; empty = disabled.
# MODEL_ROUTER_URL=http://localhost:8081
# AUTOMATION_ENGINE_URL=http://localhost:8085
# OUTCOME_FEED_QUEUE_SIZE=1000

# --- Dashboard ---
# No reading from a zone for longer than this many seconds: the dashboard's sensor-trust line says "Can't confirm:
# no reading from this zone for ..." instead of "All readings passed the sensor check" on the last stored reading.
# 600 = twice the 5-minute real log interval (fixed, not learned per zone). 0 turns it off (demos, replays with
# fixed timestamps).
ZONE_STALE_AFTER_S=600
# Where the dashboard finds the other services. Docker Compose sets these to the service names (these are its defaults).
# CORE_URL=http://core:8080
# SAFETY_CHECKER_URL=http://safety-checker:8082
# DIGITAL_TWIN_URL=http://digital-twin:8084

# --- MQTT ---
# Docker stack: leave MQTT_HOST=mqtt (default in compose)
# Host simulator: always uses localhost:1883 (see scripts/sim.sh)
# Pip local dev: run `./scripts/up.sh mqtt` then MQTT_HOST=localhost in run-local.sh
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC_PATTERN=pomona/+/+/sensor/+/state
# The broker requires a login (no anonymous access). ./scripts/setup.sh and ./scripts/up.sh fill in a
# random MQTT_PASSWORD here when it is blank. Never commit a real password: .env is gitignored.
# Stick to letters and digits (the generated hex is fine): Compose treats $ in .env values specially.
# A client with an empty MQTT_USERNAME connects without credentials (only for a broker you run yourself).
MQTT_USERNAME=pomona
MQTT_PASSWORD=

# --- Model router ---
# Backends:
#   stub         — default, works offline, no GPU (demo rules)
#   huggingface  — calls HF Inference API (needs HF_TOKEN + inference provider)
#   ollama       — local Ollama on host
POMONA_LLM_BACKEND=stub
HF_MODEL_ID=Okyanus/ai-pomona-agronomist-gemma4
HF_BASE_MODEL_ID=google/gemma-4-E2B-it
HF_TOKEN=

# Ollama on host machine (optional profile: docker compose --profile ollama up -d)
# macOS/Windows Docker Desktop: host.docker.internal works
# Linux: host-gateway is set in docker-compose.yml
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=ai-pomona-agronomist-gemma4

# Specialist reasoner runtimes. "rules" remains the safe offline default;
# choose "ollama" only after the named local models are installed and evaluated.
REASONER_BACKEND=rules
TOMATO_RISK_OLLAMA_MODEL=pomona-tomato-risk:v0.1.7-local
WATER_IRRIGATION_OLLAMA_MODEL=pomona-water-irrigation:v0.1.8
NUTRIENT_PH_EC_OLLAMA_MODEL=pomona-nutrient-ph-ec:v0.1.1
# Seconds to wait for a model: a specialist reasoner (the rules decide either way, so a slow model only delays) and the
# advisor's explanation. A model that does not answer in time is replaced by the deterministic result.
# REASONER_TIMEOUT_S=60
# ADVISOR_TIMEOUT_S=60
# mlx_lm.server runs on the Mac host, outside Docker, for Metal access.
MLX_HOST=http://host.docker.internal:8083
# Leave empty to use the model loaded by mlx_lm.server.
WATER_IRRIGATION_MLX_MODEL=

# --- Simulator (host Python, any OS) ---
SIM_FARM_ID=demo-farm
SIM_ZONE_ID=greenhouse-a
SIM_DEVICE_ID=sim-greenhouse-01
SIM_INTERVAL_SEC=5

# --- Automation history ---
# Docker Compose uses its named automation_data volume automatically.
# For host/pip use, uncomment a local persistent path:
# AUTOMATION_DB_PATH=data/automation.db
# Alerts: a risk must last this long before an alert is raised, and stay away this long to clear.
# ALERT_RAISE_AFTER_SECONDS=600
# ALERT_CLEAR_AFTER_SECONDS=900
# A silence longer than this between two readings of a zone restarts the timers of risks that are still pending
# (a label seen once, then again hours later, is not "lasting"). 0 turns it off. A raised alert is not touched.
# ALERT_MAX_GAP_SECONDS=1800
# Retains latest N suggestions including decisions, not an unlimited audit log.
MAX_SUGGESTIONS=200
# Pending suggestions expire after 15 minutes; sample context also caps freshness.
SUGGESTION_TTL_SECONDS=900
SUGGESTION_SAMPLE_MAX_AGE_SECONDS=3600

# Model-router pipeline audit file (on the router_data volume): rotated to <name>.1 when it reaches this many bytes
# (20 MB). 0 = never rotate.
# AUDIT_LOG_MAX_BYTES=20971520

# Container resource limits (docker-compose.yml lockdown): memory (*_MEM_LIMIT) and CPU cores (*_CPUS) per service.
# The values shown are the compose defaults. Raise MODEL_ROUTER_MEM_LIMIT to about 8g when POMONA_LLM_BACKEND loads a
# Hugging Face model in the container.
# CORE_MEM_LIMIT=512m
# CORE_CPUS=1.0
# MODEL_ROUTER_MEM_LIMIT=2g
# MODEL_ROUTER_CPUS=2.0
# MQTT_MEM_LIMIT=128m
# MQTT_CPUS=0.5
# DASHBOARD_MEM_LIMIT=256m
# DASHBOARD_CPUS=0.5
# DIGITAL_TWIN_MEM_LIMIT=256m
# DIGITAL_TWIN_CPUS=0.5
# AUTOMATION_MEM_LIMIT=256m
# AUTOMATION_CPUS=0.5
# SAFETY_CHECKER_MEM_LIMIT=256m
# SAFETY_CHECKER_CPUS=0.5
